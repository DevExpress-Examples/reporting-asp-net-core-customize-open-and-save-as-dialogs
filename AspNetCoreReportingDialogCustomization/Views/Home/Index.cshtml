<link rel="stylesheet" href="~/css/viewer.part.bundle.css" />
<link rel="stylesheet" href="~/css/designer.part.bundle.css" />
<link rel="stylesheet" href="~/css/ace/ace.bundle.css" />

<script src="~/js/viewer.part.bundle.js"></script>
<script src="~/js/designer.part.bundle.js"></script>

<style>
    .dxrd-reportdialog-content .dx-list-collapsible-groups .dx-list-group:first-child .dx-list-group-header {
        display: none;
    }

    .dxrd-reportdialog-content .dx-list-collapsible-groups .dx-list-item {
        border-top: 0;
    }

    .dx-designer .dx-popup-bottom.dx-toolbar .dx-toolbar-items-container {
        margin-left: 6px;
    }
</style>

<script>
    function setWidgetOption(widget, name, value) {
        if(widget) widget.option(name, value);
    }

    function normalizePath(path) {
        return (path || "").replace(/\//g, '\\');
    }

    function findCategory(categories, key) {
        return categories.filter(function(category) { return category.key === key; })[0];
    }

    function updateCategories(onCategoriesLoaded) {
        DevExpress.Reporting.Designer.ReportStorageWeb.getUrls().done(function(result) {
            var categories = [{ key: "", items: [] }];
            (result || []).forEach(function(reportItem) {
                var parts = normalizePath(reportItem.Value).split('\\');
                var reportName = parts.pop();
                var categoryName = parts.join('\\');

                var category = findCategory(categories, categoryName);
                if(!category) {
                    category = { key: categoryName, items: [] };
                    categories.push(category);
                }
                category.items.push({ text: reportItem.Key, displayName: reportName });
            });
            onCategoriesLoaded(categories);
        });
    }

    function createCancelButton(popup) {
        return {
            toolbar: 'bottom', location: 'after', widget: 'dxButton', options: {
                text: 'Cancel', onClick: function() { popup.cancel(); }
            }
        };
    }

    function customizeSaveAsDialog(s, e) {
        e.Popup.width = 700;
        e.Popup.height = 522;
        e.Popup.title = "Save";

        var categories = [];
        var nameEditor, categoryEditor, reportList;

        var model = {
            categories: categories,
            categoryName: "",
            inputValue: "",
            categoryDisplayExpr: function(item) {
                return item && item.key || "none";
            },
            onNameEditorInitialized: function(args) { nameEditor = args.component; },
            onCategoryEditorInitialized: function(args) { categoryEditor = args.component; },
            onReportListInitialized: function(args) { reportList = args.component; },
            onReportNameChanged: function(args) {
                setReportName(args.value);
            },
            onCategoryChanged: function(args) {
                model.categoryName = args.value || "";
            },
            onCustomCategoryCreating: function(args) {
                var categoryName = normalizePath(args.text).trim();
                if(!categoryName || categoryName === "none") {
                    args.customItem = null;
                    return;
                }
                args.customItem = findCategory(categories, categoryName);
                if(!args.customItem) {
                    args.customItem = { key: categoryName, items: [] };
                    // Reload the editors after updating the shared array.
                    categories.push(args.customItem);
                    if(reportList) reportList.reload();
                    if(categoryEditor) categoryEditor.getDataSource().reload();
                }
            },
            onReportClick: function(args) {
                setReportUrl(args.itemData.text);
            },
            setUrl: setReportUrl,
            getUrl: getReportUrl,
            onShow: function() {
                setReportName("");
                setWidgetOption(nameEditor, "value", "");
                updateCategories(function(loadedCategories) {
                    categories = loadedCategories;
                    model.categories = loadedCategories;
                    setWidgetOption(categoryEditor, "dataSource", categories);
                    setWidgetOption(reportList, "dataSource", categories);
                });
            },
            popupButtons: [
                {
                    toolbar: 'bottom', location: 'after', widget: 'dxButton', options: {
                        text: 'Save',
                        onClick: function() {
                            if(!model.inputValue.trim()) return;
                            e.Popup.save(getReportUrl());
                        }
                    }
                },
                createCancelButton(e.Popup)
            ]
        };

        function getReportUrl() {
            var reportName = model.inputValue.trim();
            return model.categoryName ? model.categoryName + '\\' + reportName : reportName;
        }

        function setReportName(reportName) {
            model.inputValue = reportName || "";
        }

        function setReportUrl(url) {
            var parts = normalizePath(url).split('\\');
            setReportName(parts.pop());
            model.categoryName = parts.join('\\');
            setWidgetOption(nameEditor, "value", model.inputValue);
            setWidgetOption(categoryEditor, "value", model.categoryName);
        }

        e.Customize("custom-save-as-dialog", model);
    }

    function customizeOpenDialog(s, e) {
        e.Popup.width = 700;
        e.Popup.height = 476;
        e.Popup.title = "Open";

        var searchEditor, reportList;

        var model = {
            categories: [],
            reportUrl: "",
            inputValue: "",
            onSearchEditorInitialized: function(args) { searchEditor = args.component; },
            onReportListInitialized: function(args) { reportList = args.component; },
            onSearchValueChanged: function(args) {
                setSearchText(args.value);
            },
            onReportClick: function(args) {
                selectReport(args.itemData.text);
            },
            setUrl: selectReport,
            getUrl: function() {
                return model.reportUrl;
            },
            onShow: function() {
                setWidgetOption(searchEditor, "value", "");
                setSearchText("");
                updateCategories(function(loadedCategories) {
                    model.categories = loadedCategories;
                    setWidgetOption(reportList, "dataSource", loadedCategories);
                });
            },
            popupButtons: [
                {
                    toolbar: 'bottom', location: 'after', widget: 'dxButton', options: {
                        text: 'Open',
                        onClick: function() {
                            if(!model.reportUrl) return;
                            e.Popup.open(model.reportUrl);
                        }
                    }
                },
                createCancelButton(e.Popup)
            ]
        };

        function selectReport(url) {
            model.reportUrl = url || "";
        }

        function setSearchText(text) {
            model.inputValue = text || "";
            setWidgetOption(reportList, "searchValue", model.inputValue);
        }

        e.Customize("custom-open-dialog", model);
    }
</script>
<style>
    .dxrd-reportdialog-content .reportdialog-item.dx-texteditor:not(.dx-multiline):not(.dx-textarea) {
        height: 36px;
        margin-bottom: 10px;
    }
</style>
<script type="text/html" id="custom-save-as-dialog">
    <div class="dxrd-reportdialog-content">
        <div style="margin-bottom: 10px;"
             data-bind="dxTextBox: {
                 height: 36,
                 value: inputValue,
                 valueChangeEvent: 'input',
                 onValueChanged: onReportNameChanged,
                 onInitialized: onNameEditorInitialized,
                 placeholder: 'Enter a report name to save...',
                 showClearButton: true
        }"></div>
        <div style="margin-bottom: 10px;"
             data-bind="dxSelectBox: {
                height: 36,
                dataSource: categories,
                value: categoryName,
                onValueChanged: onCategoryChanged,
                onInitialized: onCategoryEditorInitialized,
                valueExpr: 'key',
                displayExpr: categoryDisplayExpr,
                acceptCustomValue: true,
                placeholder: 'Select a category...',
                onCustomItemCreating: onCustomCategoryCreating
        }"></div>
        <div class="dx-default-border-style dxd-border-secondary"
             data-bind="dxList: {
                dataSource: categories,
                height: '260px',
                grouped: true,
                onInitialized: onReportListInitialized,
                onItemClick: onReportClick,
                displayExpr: 'displayName',
                keyExpr: 'text',
                collapsibleGroups: true
        }"></div>
    </div>
</script>

<script type="text/html" id="custom-open-dialog">
    <div class="dxrd-reportdialog-content">
        <div style="margin-bottom: 10px;"
             data-bind="dxTextBox: {
                height: 36,
                value: inputValue,
                valueChangeEvent: 'input',
                onValueChanged: onSearchValueChanged,
                onInitialized: onSearchEditorInitialized,
                placeholder: 'Enter text to search...',
                showClearButton: true
        }"></div>
        <div class="dx-default-border-style dxd-border-secondary"
             data-bind="dxList: {
                dataSource: categories,
                height: '260px',
                grouped: true,
                searchExpr: 'text',
                searchValue: inputValue,
                onInitialized: onReportListInitialized,
                onItemClick: onReportClick,
                displayExpr: 'displayName',
                keyExpr: 'text',
                collapsibleGroups: true
        }"></div>
    </div>
</script>


@(Html.DevExpress().ReportDesigner("reportDesigner")
         .Height("1000px")
         .Bind(@"Category1\Report1")
         .ClientSideEvents(configure => {
             configure.CustomizeSaveAsDialog("customizeSaveAsDialog");
             configure.CustomizeOpenDialog("customizeOpenDialog");
         }))
